{% extends 'base.html.twig' %}

{% block title %}Hello ReportController!{% endblock %}

{% block body %}
    <style>
        .example-wrapper {
            margin: 1em auto;
            max-width: 800px;
            width: 95%;
            font: 18px/1.5 sans-serif;
        }
        .example-wrapper code {
            background: #f5f5f5;
            padding: 2px 6px;
        }
    </style>

    <div class="example-wrapper">
        {% for authorId, books in reports %}
            {% set first = books|first %}
            <h4 class="mt-4">{{ first.autor_nome }}</h4>
            <table class="table table-striped">
                <thead>
                    <tr><th>Título</th><th>Editora</th><th>Ano</th><th>Valor</th></tr>
                </thead>
                <tbody>
                    {% for book in books %}
                        <tr>
                            <td>{{ book.titulo }}</td>
                            <td>{{ book.editora }}</td>
                            <td>{{ book.ano_publicacao }}</td>
                            <td>{{ book.valor }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endfor %}
    </div>
{% endblock %}
