{% extends 'base.html.twig' %}

{% block title %}Autores | {{ author.name }}{% endblock %}

{% block body %}
    {% embed 'layout/_container.html.twig' with {title: 'Autores'} %}
        {% block content %}
            <div class="card mb-2">
                <div class="card-header">
                    # {{ author.id }}
                </div>
                <div class="card-body">
                    <h5 class="card-title">{{ author.name }}</h5>
                </div>
                <div class="card-footer">
                    {% set bookCount = author.books|length %}
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong>Livros Publicados</strong>
                        <small class="text-muted">
                            {{ bookCount }} {{ bookCount == 1 ? 'livro' : 'livros' }}
                        </small>
                    </div>
                    {% if bookCount > 0 %}
                        <div class="row row-cols-1 row-cols-md-2 g-2">
                            {% for book in author.books %}
                                <div class="col">{{ book.title }}</div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <span>Nenhum livro publicado.</span>
                    {% endif %}
                </div>
            </div>
            <custom-button href="{{ path('app_author_edit', {'id': author.id}) }}">Editar</custom-button>
            <custom-button href="{{ path('app_author_index') }}" variant="outline">Voltar</custom-button>
            {{ include('author/_delete_form.html.twig') }}
        {% endblock %}
    {% endembed %}
{% endblock %}