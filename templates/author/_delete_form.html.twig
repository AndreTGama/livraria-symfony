<form
    method="post"
    action="{{ path('app_author_delete', {'id': author.id}) }}"
    data-controller="confirm"
    data-action="submit->confirm#submit"
    data-confirm-message-value="Deseja excluir o autor {{ author.name }}?"
>
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ author.id) }}">
    <custom-button type="submit" class="mt-2" variant="outline">Delete</custom-button>
</form>