{% extends 'base.html.twig' %}

{% block title %}Livros | {{ book.title }}{% endblock %}

{% block body %}
    {% embed 'layout/_container.html.twig' with {title: 'Autores'} %}
        {% block content %}
            <div class="card mb-2">
                <div class="card-header">
                    # {{ book.id }}
                </div>
                <div class="card-body">
                    <h5 class="card-title">{{ book.title }}</h5>
                    <p>
                        <b>Editora:</b> {{ book.publisher }}
                    </p>
                    <p>
                        <b>Edição:</b> {{ book.edition }}
                    </p>
                    <p>
                        <b>Ano de Publicação:</b> {{ book.publicationYear }}
                    </p>
                </div>
                <div class="card-footer">
                    {% set authorCount = book.authors|length %}
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong>{{ authorCount == 1 ? 'Autor' : 'Autores' }}</strong>
                        <small class="text-muted">
                            {{ authorCount }} {{ authorCount == 1 ? 'Autor' : 'Autores' }}
                        </small>
                    </div>
                    <div class="row row-cols-1 row-cols-md-2 g-2">
                        {% for author in book.authors %}
                            <div class="col">{{ author.name }}</div>
                        {% endfor %}
                    </div>
                </div>
                <div class="card-footer">
                    {% set subjectCount = book.subjects|length %}
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong>{{ subjectCount == 1 ? 'Assunto' : 'Assuntos' }}</strong>
                        <small class="text-muted">
                            {{ subjectCount }} {{ subjectCount == 1 ? 'Assunto' : 'Assuntos' }}
                        </small>
                    </div>
                    <div class="row row-cols-1 row-cols-md-2 g-2">
                        {% for subject in book.subjects %}
                            <div class="col">{{ subject.description }}</div>
                        {% endfor %}
                    </div>
                </div>
            </div>
            <custom-button href="{{ path('app_book_edit', {'id': book.id}) }}">Editar</custom-button>
            <custom-button href="{{ path('app_book_index') }}" variant="outline">Voltar</custom-button>
            {{ include('book/_delete_form.html.twig') }}
        {% endblock %}
    {% endembed %}
{% endblock %}
