<form
    method="post"
    action="{{ path('app_subject_delete', {'id': subject.id}) }}"
    data-controller="confirm"
    data-action="submit->confirm#submit"
    data-confirm-message-value="Deseja excluir o autor {{ author.name }}?"
>
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ subject.id) }}">
    <button class="btn">Delete</button>
</form>
