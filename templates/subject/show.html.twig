{% extends 'base.html.twig' %}

{% block title %}Assuntos | {{ subject.description }}{% endblock %}

{% block body %}
    {% embed 'layout/_container.html.twig' with {title: 'Assuntos'} %}
        {% block content %}
            <div class="card mb-2">
                <div class="card-header">
                    # {{ subject.id }}
                </div>
                <div class="card-body">
                    <h5 class="card-title">{{ subject.description }}</h5>
                </div>
                <div class="card-footer">
                    {% set bookCount = subject.books|length %}
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong>Livros</strong>
                        <small class="text-muted">
                            {{ bookCount }} {{ bookCount == 1 ? 'livro' : 'livros' }}
                        </small>
                    </div>
                    {% if bookCount > 0 %}
                        <div class="row row-cols-1 row-cols-md-2 g-2">
                            {% for book in subject.books %}
                                <div class="col">{{ book.title }}</div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <span>Nenhum livro associado a este assunto.</span>
                    {% endif %}
                </div>
            </div>
            <custom-button href="{{ path('app_subject_edit', {'id': subject.id}) }}">Editar</custom-button>
            <custom-button href="{{ path('app_subject_index') }}" variant="outline">Voltar</custom-button>
            {{ include('subject/_delete_form.html.twig') }}
        {% endblock %}

    {% endembed %}

{% endblock %}
