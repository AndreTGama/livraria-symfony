{% extends 'base.html.twig' %}

{% block title %}Assuntos | lista{% endblock %}

{% block body %}
    {% embed 'layout/_container.html.twig' with {title: 'Assuntos'} %}
        {% block content %}
            <div class="d-flex flex-row-reverse">
                <custom-button href="{{ path('app_subject_new') }}" class="mb-2">+ Assunto</custom-button>
            </div>
            <div class="card">
                <div class="car-body p-1">
                    {{ render_datatable(table, {'class': 'table table-striped'}) }}
                </div>
            </div>
        {% endblock %}
    {% endembed %}
{% endblock %}
