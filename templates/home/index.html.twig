{% extends 'base.html.twig' %}

{% block title %}Bem-vindo a Livraria!{% endblock %}

{% block body %}
    {% include 'layout/_header.html.twig' %}
    <main class="custom-container">
        {%  include 'layout/_title.html.twig' with {'title': 'Livros', 'href': path('app_book_index')} %}
        <section class="row mt-5">
            <aside class="col-lg-3 mb-4">
                {% include 'layout/_filter.html.twig' with {
                    subjects: subjects,
                    authors: authors,
                    selectedSubjectIds: selectedSubjectIds,
                    selectedAuthorIds: selectedAuthorIds,
                    search: search
                } %}
            </aside>

            <div class="col-lg-9">
                <p class="text-muted" role="status">
                    {{ totalBooks }} {{ totalBooks == 1 ? 'livro encontrado' : 'livros encontrados' }}
                </p>

                {% if books is empty %}
                    <div class="alert alert-info" role="status">
                        Nenhum livro encontrado com os filtros selecionados.
                    </div>
                {% else %}
                    <div class="book-grid">
                        {% for book in books %}
                            {% include 'layout/_card.html.twig' with {book: book} %}
                        {% endfor %}
                    </div>

                    {% include 'layout/_pagination.html.twig' with {
                        page: page,
                        totalPages: totalPages
                    } %}
                {% endif %}
            </div>
        </section>
    </main>
{% endblock %}
