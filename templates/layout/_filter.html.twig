<form action="{{ path('app_home') }}" method="get" class="catalog-filter">
    <h3>Filtrar livros</h3>

    <div class="mb-3">
        <label for="catalog-search" class="form-label">Título ou editora</label>
        <input
            id="catalog-search"
            name="q"
            type="search"
            class="form-control"
            value="{{ search }}"
            placeholder="Buscar livros"
        >
    </div>

    <div class="mb-3">
        <label class="form-label d-block">Assuntos</label>
        {% for item in subjects %}
            <div class="form-check">
                <input
                    type="checkbox"
                    class="form-check-input"
                    name="subjects[]"
                    id="subject-{{ item.id }}"
                    value="{{ item.id }}"
                    {{ item.id in selectedSubjectIds ? 'checked' : '' }}
                />
                <label class="form-check-label" for="subject-{{ item.id }}">
                    {{ item.description }}
                </label>
            </div>
        {% else %}
            <p class="text-muted small mb-0">Nenhum assunto cadastrado.</p>
        {% endfor %}
    </div>

    <div class="mb-3">
        <label for="catalog-authors" class="form-label">Autores</label>
        <select id="catalog-authors" name="authors[]" class="form-select" multiple size="5">
            {% for author in authors %}
                <option value="{{ author.id }}" {{ author.id in selectedAuthorIds ? 'selected' }}>
                    {{ author.name }}
                </option>
            {% else %}
                <option disabled>Nenhum autor cadastrado</option>
            {% endfor %}
        </select>
    </div>

    <button type="submit" class="btn btn-primary w-100">Aplicar filtros</button>
    <a href="{{ path('app_home') }}" class="btn btn-outline-secondary w-100 mt-2">Limpar filtros</a>
</form>
