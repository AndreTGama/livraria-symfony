<form action="{{ path('app_home') }}" method="get" class="catalog-filter">
    <h3>Filtrar livros</h3>

    <div class="mb-3">
        <label for="catalog-search" class="form-label"><b>Título ou editora</b></label>
        <input
            id="catalog-search"
            name="q"
            type="search"
            class="form-control"
            value="{{ search }}"
            placeholder="Buscar livros"
        >
    </div>

    <div class="mb-3">
        <label class="form-label d-block"><b>Assuntos</b></label>
        {% for item in subjects %}
            <div class="form-check">
                <input
                    type="checkbox"
                    class="form-check-input"
                    name="subjects[]"
                    id="subject-{{ item.id }}"
                    value="{{ item.id }}"
                    {{ item.id in selectedSubjectIds ? 'checked' : '' }}
                />
                <label class="form-check-label" for="subject-{{ item.id }}">
                    {{ item.description }}
                </label>
            </div>
        {% else %}
            <p class="text-muted small mb-0">Nenhum assunto cadastrado.</p>
        {% endfor %}
    </div>

    <div class="mb-3">
        <label class="form-label d-block"><b>Autores</b></label>
        {% for author in authors %}
            <div class="form-check">
                <input
                    type="checkbox"
                    class="form-check-input"
                    name="authors[]"
                    id="author-{{ author.id }}"
                    value="{{ author.id }}"
                    {{ author.id in selectedAuthorIds ? 'checked' : '' }}
                />
                <label class="form-check-label" for="author-{{ author.id }}">
                    {{ author.name }}
                </label>
            </div>
        {% else %}
            <p class="text-muted small mb-0">Nenhum autor cadastrado.</p>
        {% endfor %}
    </div>
    <custom-button type="submit">Filtrar</custom-button>
    <custom-button href="{{ path('app_home') }}" variant="outline" class="mt-2">Limpar filtros</custom-button>
</form>
