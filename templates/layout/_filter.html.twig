<nav class="list-group subject-filter">
    <a
        href="{{ path('app_home') }}"
        class="list-group-item list-group-item-action {{ subjectActive is null ? 'active' }}"
        {% if subjectActive is null %}aria-current="page"{% endif %}
    >
        Todos os assuntos
    </a>

    {% for item in subjects %}
        {% set isActive = subjectActive == item.id %}
        <a
            href="{{ path('app_home', {subject: item.id}) }}"
            class="list-group-item list-group-item-action d-flex justify-content-between align-items-center {{ isActive ? 'active' }}"
            {% if isActive %}aria-current="page"{% endif %}
        >
            {{ item.description }}
            <span class="badge rounded-pill text-bg-light">{{ item.total }}</span>
        </a>
    {% else %}
        <p class="text-muted">Nenhum assunto cadastrado.</p>
    {% endfor %}
</nav>
