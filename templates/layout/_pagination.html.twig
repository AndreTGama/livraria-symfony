<style>
    .custom-font-color-disable {
        color: var(--dark-purple-color) !important;
    }

    .custom-font-color {
        color: var(--purple-color) !important;
    }

    .custom-color-white {
        color: white !important;
    }

    .custom-background-active {
        background-color: var(--purple-color) !important;
        border-color: var(--dark-purple-color) !important;
    }
</style>
{% if totalPages > 1 %}
    <nav class="mt-4" aria-label="Paginação dos livros">
        <ul class="pagination justify-content-center">
            <li class="page-item {{ page == 1 ? 'disabled' }}">
                {% if page > 1 %}
                    <a class="page-link custom-font-color" href="{{ path('app_home', app.request.query.all|merge({page: page - 1})) }}" aria-label="Página anterior">Anterior</a>
                {% else %}
                    <span class="page-link custom-font-color-disable">Anterior</span>
                {% endif %}
            </li>

            {% for pageNumber in max(1, page - 2)..min(totalPages, page + 2) %}
                <li class="page-item {{ pageNumber == page ? 'active' }}">
                    <a
                        class="page-link custom-font-color {{ pageNumber == page ? 'custom-background-active custom-color-white'}}"
                        href="{{ path('app_home', app.request.query.all|merge({page: pageNumber})) }}"
                        {% if pageNumber == page %}aria-current="page"{% endif %}
                    >{{ pageNumber }}</a>
                </li>
            {% endfor %}

            <li class="page-item {{ page == totalPages ? 'disabled' }}">
                {% if page < totalPages %}
                    <a class="page-link custom-font-color" href="{{ path('app_home', app.request.query.all|merge({page: page + 1})) }}" aria-label="Próxima página">Próxima</a>
                {% else %}
                    <span class="page-link custom-font-color-disable">Próxima</span>
                {% endif %}
            </li>
        </ul>
    </nav>
{% endif %}
