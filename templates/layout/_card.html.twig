<article class="card book-card h-100">
    <div class="card-body d-flex flex-column">
        <h3 class="h5 card-title">{{ book.title }}</h3>
        <p class="card-subtitle mb-2 text-body-secondary">
            {{ book.authors|map(author => author.name)|join(', ') ?: 'Autor não informado' }}
        </p>
        <p class="card-text mb-1"><strong>Editora:</strong> {{ book.publisher }}</p>
        <p class="card-text mb-1"><strong>Edição:</strong> {{ book.edition }}</p>
        <p class="card-text mb-3"><strong>Ano:</strong> {{ book.publicationYear }}</p>

        {% if book.subjects is not empty %}
            <div class="d-flex flex-wrap gap-1 mb-3">
                {% for subject in book.subjects %}
                    <span class="badge text-bg-light">{{ subject.description }}</span>
                {% endfor %}
            </div>
        {% endif %}

        <div class="mt-auto d-flex justify-content-between align-items-center">
            <span class="fw-semibold">R$ {{ book.price|number_format(2, ',', '.') }}</span>
            <a href="{{ path('app_book_show', {id: book.id}) }}" class="btn btn-sm btn-outline-primary">
                Ver livro
            </a>
        </div>
    </div>
</article>
